# Never let real credentials into an image layer. The Dockerfile copies
# explicit paths rather than the whole tree, but this is the belt to that
# braces — config.json holds the Discord token and Hi-Rez keys.
config.json
session
version
gods.json
items.json
cache/
# Locally-seeded historical corpus. It belongs on the NAS, not in a layer.
matchDetails/
# The web UI's installed dependencies and last local build. Dockerfile.web runs
# `npm ci` and `npm run build` in its own stage; shipping a host-built dist into
# the context would mean the image contents depend on whoever ran build.sh.
src/web/ui/node_modules/
src/web/ui/dist/
templates/
.venv/
.git/
**/__pycache__/
*.pyc
