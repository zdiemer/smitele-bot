# Copy to values.local.yaml (gitignored) and fill in.
#
#   cp values.local.yaml.example values.local.yaml
#
# Hi-Rez credentials come from https://webcdn.hirezstudios.com/hirez-studios/legal/smite-api-developer-guide.pdf
# (request a dev ID + auth key); the Discord token from the bot's application
# page at https://discord.com/developers/applications.

credentials:
  discordToken: ""
  hirezDevId: ""
  hirezAuthKey: ""
  # Optional. A Steam Web API key (steamcommunity.com/dev/apikey) lets
  # /livematch say "playing Smite 2, lobby not posted yet" instead of a flat
  # "not in a match" while tracker.gg's ~10 min snapshot catches up. Leave
  # empty to answer from tracker.gg alone.
  steamApiKey: ""
  # Optional. A RallyHere session captured off your own Smite 2 client
  # (scripts/win/README.md), which reads presence and live sessions from the
  # backend itself — seconds fresh, against tracker.gg's ~10 minutes.
  #
  # `clientBasic` is the `client_id:client_secret` the capture decodes out of
  # the client's login request; without it the token works until it expires
  # (~6h) and cannot be renewed. These SEED /data/rh_state.json, where the bot
  # keeps the access token it renews for itself — so pasting a fresh capture
  # here is how you recover a dead session, and leaving it alone across
  # restarts is correct.
  rallyHere:
    token: ""
    refreshToken: ""
    clientBasic: ""

# Only needed once the NAS share exists and you flip these on. Same TrueNAS
# user the other charts use.
matchData:
  enabled: false
  username: ""
  password: ""

collector:
  enabled: false

# smite.diemer.codes. Both need matchData.enabled — the snapshots live on the
# share, because the CronJob that writes them and the web pods that read them
# are different pods. No secrets of their own: the web tier holds no
# credentials at all, which is what makes a public URL safe against a metered
# API. Remember the Cloudflare Public Hostname entry — see README §The website.
web:
  enabled: false
snapshot:
  enabled: false
