[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
beautifulsoup4 = "~=4.11.1"
pillow = "~=9.3.0"
unidecode = "~=1.3.6"
pynacl = "~=1.5.0"
aiohttp = "~=3.8.3"
edit-distance = "~=1.0.4"
py-cord = "~=2.4.1"
numpy = "~=1.25.2"
six = "~=1.16.0"
python-dateutil = "~=2.8.2"
pytz = "~=2023.3"
tzdata = "~=2023.3"
pandas = "~=2.1.0"
# SmiteProvider does `import ujson as json` to parse the match-detail corpus,
# but this was never declared — a clean `pipenv install --deploy` produced an
# environment the bot could not start in.
ujson = "~=5.8.0"
# Parquet is the corpus format: ~25x smaller than the raw JSON and read
# column-wise, so the bot loads only the fields it uses.
pyarrow = "~=14.0"

[dev-packages]

[requires]
python_version = "3.11"
