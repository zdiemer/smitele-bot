[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
beautifulsoup4 = "~=4.11.1"
pillow = "~=9.3.0"
unidecode = "~=1.3.6"
pynacl = "~=1.5.0"
aiohttp = "~=3.8.3"
edit-distance = "~=1.0.4"
py-cord = "~=2.4.1"
numpy = "~=1.25.2"
six = "~=1.16.0"
python-dateutil = "~=2.8.2"
pytz = "~=2023.3"
tzdata = "~=2023.3"
pandas = "~=2.1.0"
# SmiteProvider does `import ujson as json` to parse the match-detail corpus,
# but this was never declared — a clean `pipenv install --deploy` produced an
# environment the bot could not start in.
ujson = "~=5.8.0"
# Parquet is the corpus format: ~25x smaller than the raw JSON and read
# column-wise, so the bot loads only the fields it uses.
pyarrow = "~=14.0"
# Streaming JSON, for converting archived days. Whole-file parsing needs about
# eight times the file size in memory and archived days reach 3GB. Also used to
# stream tracker.gg's ~2.9MB match pages instead of buffering them.
ijson = "~=3.5"
# tracker.gg sits behind Cloudflare, which checks that the TLS handshake matches
# the user agent. aiohttp is refused with a 403 no matter what headers it sends;
# curl_cffi replays a real Firefox handshake, which is what the clearance cookie
# is minted against. Not a general replacement for aiohttp — only this one host
# needs it.
curl-cffi = "~=0.16"

[dev-packages]
# There were no tests at all before Smite 2. The ones that exist now cover the
# places where being wrong is silent — a build hashed into the wrong bucket, a
# corpus path that lets two games' matches mix — rather than everything.
pytest = "==8.4.2"
pytest-asyncio = "~=0.24"
# The clearance minter. Only the collector and the bot's Smite 2 player lookups
# need a browser, and only to solve a Cloudflare challenge — never to fetch
# data. Kept out of [packages] because the image installs it explicitly in the
# layer that needs it; a plain checkout can run everything else without pulling
# a patched Firefox.
camoufox = {extras = ["geoip"], version = "~=0.5"}

[requires]
python_version = "3.11"
