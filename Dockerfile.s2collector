# The Smite 2 crawl image: the bot image plus a browser.
#
# tracker.gg and its API both sit behind Cloudflare, and neither will talk to a
# plain HTTP client. A real browser has to solve the challenge once; the cookie
# it earns is then replayed by curl_cffi for the rest of the night, so the
# browser runs for about ten seconds of a multi-hour job and never sees a
# multi-megabyte payload.
#
# Separate from the bot image because Camoufox drags in a patched Firefox and
# the X and GTK libraries around it — several hundred megabytes that a bot pod
# held under a 2Gi limit has no use for.
#
# Built by build.sh alongside the main image and tagged in lockstep with it.
ARG BASE_IMAGE=ghcr.io/zdiemer/smitele-bot
ARG BASE_TAG=latest
FROM ${BASE_IMAGE}:${BASE_TAG}

USER root

# Firefox's runtime dependencies. Camoufox ships the browser itself but not the
# system libraries it links against, and the failure without them is an opaque
# "browser closed unexpectedly" rather than a missing-library error.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libgtk-3-0 \
      libx11-xcb1 \
      libxcb-shm0 \
      libxcomposite1 \
      libxcursor1 \
      libxdamage1 \
      libxfixes3 \
      libxi6 \
      libxrandr2 \
      libxtst6 \
      libasound2 \
      libdbus-glib-1-2 \
      libpci3 \
 && rm -rf /var/lib/apt/lists/*

# Retried, because this fails intermittently and takes the whole image with it.
# Both this and the fetch below pull from the network — PyPI here, and camoufox's
# own release host plus the MaxMind geoip database there — and a single dropped
# connection failed a build that had nothing wrong with it. Backs off between
# attempts and still fails the build if none of them land, so a genuinely broken
# dependency is not papered over.
RUN set -eu; \
    for attempt in 1 2 3 4 5; do \
      pip install --no-cache-dir "camoufox[geoip]" && exit 0; \
      echo "camoufox install failed (attempt ${attempt}/5), retrying" >&2; \
      sleep $((attempt * 5)); \
    done; \
    echo "camoufox install failed after 5 attempts" >&2; \
    exit 1

# Where the browser lives, declared rather than left to whatever HOME happens
# to be. camoufox resolves its install directory through platformdirs, i.e.
# XDG_CACHE_HOME — so if the pod points that at its writable emptyDir, camoufox
# looks there, finds nothing, and fails with "official/stable is not installed"
# at the first mint. Setting it in the image means the pod cannot get it wrong
# by supplying its own HOME.
ENV XDG_CACHE_HOME=/home/smitele/.cache

# Fetch at build time, not at run time. The CronJob runs with
# readOnlyRootFilesystem, so a first-run download would have nowhere to land —
# and a nightly job should not pull a browser before it starts.
RUN set -eu; \
    for attempt in 1 2 3 4 5; do \
      python -m camoufox fetch && break; \
      echo "camoufox fetch failed (attempt ${attempt}/5), retrying" >&2; \
      sleep $((attempt * 5)); \
      if [ "${attempt}" = "5" ]; then \
        echo "camoufox fetch failed after 5 attempts" >&2; exit 1; \
      fi; \
    done; \
    chmod -R a+rX /home/smitele/.cache

# Prove the fetch landed where this image says it did. Without this the
# mismatch above is invisible until a crawl fails against the live site.
RUN python -c "from camoufox.pkgman import installed_verstr; \
print('camoufox browser', installed_verstr())"

USER smitele

ENTRYPOINT ["python", "./src/smite2_collector/collect.py"]
